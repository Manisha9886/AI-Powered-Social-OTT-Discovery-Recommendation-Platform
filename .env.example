# Environment
ENVIRONMENT=development

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ott_discovery
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ott_discovery

# Auth
JWT_SECRET=your_super_secret_jwt_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External APIs
TMDB_API_KEY=your_tmdb_api_key_here
LLM_API_KEY=your_llm_api_key_here

# Vector DB (Optional for early stages)
VECTOR_DB_URL=

# Frontend
VITE_API_URL=http://localhost:8000

# SSL Certificates (Uncomment and set these if you encounter Pinecone SSL verification errors on Windows)
# SSL_CERT_FILE="C:\path\to\your\python\Lib\site-packages\certifi\cacert.pem"
# REQUESTS_CA_BUNDLE="C:\path\to\your\python\Lib\site-packages\certifi\cacert.pem"
